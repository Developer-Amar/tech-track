# =============================================================================
# Tech Track — Infrastructure Environment Variables
# =============================================================================
# Copy this file to .env and replace the placeholder value below.
#
#   cp .env.example .env
#   nano .env            # set a strong, random secret
#
# The secret is shared between the Vercel backend and this VM.  Both sides
# must use the exact same value.
# =============================================================================

PISTON_SHARED_SECRET=change-me-to-a-long-random-string
