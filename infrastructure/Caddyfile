# =============================================================================
# Tech Track — Caddyfile
# =============================================================================
# Reverse proxy that sits in front of Piston on the Oracle Cloud VM.
#
# Listens on :2001 (HTTP — no TLS, since the VM has no domain name).
# Every request MUST include an X-Piston-Secret header whose value matches
# the PISTON_SHARED_SECRET env var; otherwise Caddy returns 403 Forbidden.
# =============================================================================

:2001 {
	# -------------------------------------------------------------------------
	# Shared-secret gate
	# -------------------------------------------------------------------------
	# Block the request immediately if the header is missing or wrong.
	@bad_secret {
		not header X-Piston-Secret "{env.PISTON_SHARED_SECRET}"
	}
	respond @bad_secret 403 {
		body "Forbidden: invalid or missing X-Piston-Secret header"
		close
	}

	# -------------------------------------------------------------------------
	# Reverse proxy to Piston
	# -------------------------------------------------------------------------
	reverse_proxy piston:2000 {
		# 30 s total — enough for compile + run within Piston's own limits
		transport http {
			read_timeout  30s
			write_timeout 30s
			dial_timeout   5s
		}

		# Strip the secret header before it reaches Piston (defence-in-depth)
		header_up -X-Piston-Secret
	}

	log {
		output stdout
		format console
	}
}
