# ──────────────────────────────────────────────────────────────
# Tech Track — Environment Variables
# Copy this file to .env.local and fill in the real values.
# See README.md for setup instructions.
# ──────────────────────────────────────────────────────────────

# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth — domain restriction for Chitkara University
GOOGLE_HD_DOMAIN=chitkara.edu.in

# Piston code judge — your self-hosted instance on Oracle Cloud
# The URL should include the port (e.g., http://your-vm-ip:2001)
PISTON_API_URL=http://your-oracle-vm-ip:2001
PISTON_SHARED_SECRET=change-me-to-a-long-random-string
